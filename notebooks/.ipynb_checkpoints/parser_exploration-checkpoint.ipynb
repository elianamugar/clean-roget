    "from bs4 import BeautifulSoup\n",
    "from pathlib import Path\n",
    "\n",
    "html = Path(\"../data/raw/roget.html\").read_text(encoding=\"utf-8\")\n",
    "\n",
    "soup = BeautifulSoup(html, \"xml\")\n",
    "\n",
    "print(soup.title.text)"
